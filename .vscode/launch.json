{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Confluence Explorer server",
      "program": "${workspaceFolder}/packages/simply-confluence-explorer/bin/run.js",
      "cwd": "${workspaceFolder}/packages/simply-confluence-explorer",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
